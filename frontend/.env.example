# Frontend environment variables — copy to .env.local and fill in real values.

# Password required to sign in to the operator dashboard.
# Generate a fresh random value, e.g.: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
DASHBOARD_PASSWORD=changeme-generate-a-random-password

# Must match the backend's OPERATOR_PIN exactly. Only read server-side (by
# /api/operator-pin, itself gated behind the admin_token cookie) — never expose
# this as NEXT_PUBLIC_*, or every visitor could read it out of the JS bundle.
OPERATOR_PIN=changeme-must-match-backend-OPERATOR_PIN

# Must match the backend's API_KEY exactly. NOTE: this one IS shipped to the
# browser (NEXT_PUBLIC_*) so the admin dashboard's client-side fetch calls can
# authenticate directly against the backend. That means it's visible to anyone
# who opens devtools on an authenticated session — see security report for the
# residual risk and the real fix (server-side proxy).
NEXT_PUBLIC_API_KEY=changeme-must-match-backend-API_KEY

# Backend Socket.IO server URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Backend REST API URL
NEXT_PUBLIC_API_URL=http://localhost:3001
