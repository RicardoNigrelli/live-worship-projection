# NO usar Alpine: embedded-postgres publica binarios linux-x64 estandar
# (glibc), sin variante musl. Alpine (musl) haria fallar el binario al
# arrancar. Debian slim trae glibc, compatible.

# ---- Build stage ----
# Corre embedded-postgres de verdad en esta etapa (no solo compila TS), asi
# que necesita las mismas libs nativas que la etapa de produccion.
FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libicu-dev \
    && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Hornea la base: initdb + prisma db push + seed, UNA sola vez aca, no en
# cada arranque del contenedor. Ver src/prebake-db.ts para el porque.
RUN node dist/prebake-db.js

# ---- Production stage ----
FROM node:22-bookworm-slim AS production
WORKDIR /app

# Dependencias nativas minimas que a veces pide el binario embebido de postgres
RUN apt-get update && apt-get install -y --no-install-recommends libicu-dev \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm ci --omit=dev
# El adaptador Prisma se genera en base a package.json/schema — el paquete
# @embedded-postgres/linux-x64 (optionalDependency) se instala aca solo,
# npm resuelve la plataforma actual del contenedor.

COPY --from=build /app/dist ./dist
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/.pgdata-demo ./.pgdata-demo
RUN npx prisma generate

# Usuario no-root
RUN groupadd -g 1001 urban && useradd -u 1001 -g urban -m urban
# Postgres exige que su data dir tenga permisos EXACTOS 0700 (o 0750) — el
# COPY --from=build no preserva eso de forma confiable, hay que forzarlo.
RUN chmod 700 /app/.pgdata-demo && chown -R urban:urban /app
USER urban

EXPOSE 3001
CMD ["node", "dist/bootstrap.js"]
