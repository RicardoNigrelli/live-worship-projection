# Backend environment variables — copy to .env and fill in real values.

# DATABASE_URL — NOT used by default in this demo. `npm run dev` / `npm run start`
# run backend/src/bootstrap.ts, which spins up an embedded Postgres server and
# overwrites this value at runtime (see the README's "Database in this demo"
# section). It's only read as-is if you set USE_EMBEDDED_DB=false and run
# `npm run dev:server-only` / `npm run start:server-only` instead, e.g. against a
# real NeonDB/Supabase/Railway Postgres instance:
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require&channel_binding=require

# PIN required by the operator dashboard/stage views to authenticate as a room operator
# (validated server-side in socket.ts join_room; must match what the dashboard sends).
# Generate a fresh random value for each deployment, e.g.: node -e "console.log(require('crypto').randomInt(1000,10000))"
OPERATOR_PIN=changeme-generate-a-random-4-digit-pin

# Shared secret required (via the x-api-key header) for all write REST endpoints
# (songs/services/decks/media/export CRUD). Generate a fresh random value, e.g.:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=changeme-generate-a-random-secret

# Allowed CORS origin for the frontend (use "*" for local dev, or a specific origin in production)
FRONTEND_URL=*

# Port the Express/Socket.IO server listens on
PORT=3001

# Cloudinary media storage credentials (https://cloudinary.com)
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# Spotify Web API credentials (client-credentials flow, used to import playlists)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
